#!/usr/bin/env zsh

# Less colors for man pages
export LESS_TERMCAP_mb=$'\e[01;31m'       # begin blinking
export LESS_TERMCAP_md=$'\e[01;38;5;74m'  # begin bold
export LESS_TERMCAP_me=$'\e[0m'           # end mode
export LESS_TERMCAP_se=$'\e[0m'           # end standout-mode
export LESS_TERMCAP_so=$'\e[38;5;246m'    # begin standout-mode - info box
export LESS_TERMCAP_ue=$'\e[0m'           # end underline
export LESS_TERMCAP_us=$'\e[04;38;5;146m' # begin underline

# export LDFLAGS="-L${HOMEBREW_PREFIX}/opt/ruby/lib -L${HOMEBREW_PREFIX}/opt/curl/lib -L${HOMEBREW_PREFIX}/opt/python@3.14/lib -L${HOMEBREW_PREFIX}/opt/openssl@4/lib -L${HOMEBREW_PREFIX}/opt/libffi/lib -L${HOMEBREW_PREFIX}/opt/icu4c/lib -L${HOMEBREW_PREFIX}/opt/sqlite/lib"
# export CPPFLAGS="-I${HOMEBREW_PREFIX}/opt/ruby/include -I${HOMEBREW_PREFIX}/opt/openssl@4/include -I${HOMEBREW_PREFIX}/opt/curl/include -I${HOMEBREW_PREFIX}/opt/libffi/include -I${HOMEBREW_PREFIX}/opt/icu4c/include -I${HOMEBREW_PREFIX}/opt/sqlite/include"
# export PKG_CONFIG_PATH="${HOMEBREW_PREFIX}/opt/curl/lib/pkgconfig:${HOMEBREW_PREFIX}/opt/ruby/lib/pkgconfig"

export EDITOR="vim"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
export BAT_THEME="Solarized (dark)"

export GOPATH="${HOME}/go"
export PATH="${PATH}:${GOPATH}/bin"

# configure history
export HISTFILE="${HOME}/.zsh_history"
export HISTSIZE=100000
export SAVEHIST=100000
setopt INC_APPEND_HISTORY
export HISTTIMEFORMAT="%d/%m/%y %T"
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt EXTENDED_HISTORY

command -v bat >/dev/null && alias cat='bat --pager=never'
command -v bat >/dev/null && alias less='bat'
command -v gls >/dev/null && alias ls='gls -la --color=auto --group-directories-first'
command -v grep >/dev/null && alias grep='grep --color=auto'
command -v fgrep >/dev/null && alias fgrep='fgrep --color=auto'
command -v egrep >/dev/null && alias egrep='egrep --color=auto'
alias history='history 1'
command -v helm >/dev/null && alias hm='helm'
if command -v git >/dev/null; then
	alias gco='git checkout'
	alias gf='git diff'
	alias gcm='git commit'
	alias gp='git push origin HEAD'
	alias gs='git status'
	alias gpom='git pull origin'
fi
if command -v kubectl >/dev/null; then
	if command -v kubecolor >/dev/null; then
		alias k='kubecolor'
		alias kubectl='kubecolor'
	fi
	alias kg='kubectl get'
	alias kd='kubectl describe'
fi

if command -v gdircolors >/dev/null && [[ -r "$HOME/.dir_colors/dircolors.256dark" ]]; then
	eval "$(gdircolors "$HOME/.dir_colors/dircolors.256dark")"
fi

if [[ -n ${HOMEBREW_PREFIX:-} && -r "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
	source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# Pure prompt
fpath+=${HOME}/.zsh/pure

autoload -U promptinit
promptinit

# change the path color
zstyle :prompt:pure:path color cyan

prompt pure

set -o emacs

# export USE_GKE_GCLOUD_AUTH_PLUGIN=True

command -v gbase64 >/dev/null && alias base64=gbase64
command -v gsed >/dev/null && alias sed=gsed
if command -v terraform >/dev/null; then
	alias tf=terraform
	alias tfp="tf plan"
	alias tfa="tf apply"
fi
